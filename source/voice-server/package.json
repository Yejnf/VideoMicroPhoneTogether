{
  "name": "videotogether-voice-server",
  "version": "1.0.0",
  "private": true,
  "description": "Server-relayed encrypted audio chat for VideoTogether",
  "main": "src/server.js",
  "scripts": {
    "build": "esbuild browser/voice-client-deps.js --bundle --format=iife --global-name=VideoTogetherVoiceDeps --outfile=public/voice-client-deps.js --minify",
    "start": "node src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "mediasoup": "3.16.8",
    "mediasoup-client": "3.8.4",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "socket.io-client": "4.8.1"
  },
  "engines": {
    "node": ">=20"
  }
}
