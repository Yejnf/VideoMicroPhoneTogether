# Public IPv4 address announced in WebRTC ICE candidates.
PUBLIC_IP=203.0.113.10
DOMAIN=voice.example.com
PORT=3000
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100
# Required by default. Replace this with a long random value before deploying.
ROOM_SECRET=generate-a-long-random-secret-here
# Set true only if you intentionally want public voice rooms without a shared secret.
ALLOW_OPEN_ROOMS=false
CORS_ORIGIN=*
